{
  "Comment": "SnapTrack AI Receipt Processing Pipeline",
  "StartAt": "ExtractImage",
  "States": {
    "ExtractImage": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:439475769950:function:step1_extractImage",
      "Next": "AnalyzeCalories"
    },
    "AnalyzeCalories": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:439475769950:function:step2_analyzeCalories",
      "Next": "SaveToDatabase",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ]
    },
    "SaveToDatabase": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:439475769950:function:step3_saveToDatabase",
      "End": true
    }
  }
}
